# Server installation script

# Ensure HOME is set first
if [ -z "$HOME" ]; then
    export HOME="$(eval echo ~$(whoami))"
fi

# Resolve the directory this script lives in (scripts/) and the project root (one level up)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

echo "${DISTRO_VERSION}"
echo "${DISTRO_COMMIT}"
echo "${DISTRO_VSCODIUM_RELEASE}"

TMP_DIR="${XDG_RUNTIME_DIR:-"/tmp"}"
DISTRO_VERSION="${DISTRO_VERSION}"
DISTRO_BUILD_VERSION="1.105.17075"
DISTRO_QUALITY="${DISTRO_QUALITY}"
DISTRO_VSCODIUM_RELEASE="${DISTRO_VSCODIUM_RELEASE}"
DISTRO_COMMIT="${DISTRO_COMMIT}"

if [[ "$DISTRO_VSCODIUM_RELEASE" == bob* ]]; then
    EFFECTIVE_COMMIT=${DISTRO_COMMIT}-${DISTRO_VSCODIUM_RELEASE}
else
    EFFECTIVE_COMMIT=${DISTRO_COMMIT}
fi

SERVER_APP_NAME="${SERVER_APP_NAME}"
SERVER_INITIAL_EXTENSIONS="${SERVER_EXTENSIONS}"
SERVER_LISTEN_FLAG="${USE_SOCKET_PATH}"
SERVER_DATA_DIR="$HOME/${SERVER_DATA_FOLDER}"
SERVER_DIR="$SERVER_DATA_DIR/bin/$EFFECTIVE_COMMIT"
SERVER_SCRIPT="$SERVER_DIR/bin/$SERVER_APP_NAME"
SERVER_LOGFILE="$SERVER_DATA_DIR/.$EFFECTIVE_COMMIT.log"
SERVER_PIDFILE="$SERVER_DATA_DIR/.$EFFECTIVE_COMMIT.pid"
SERVER_TOKENFILE="$SERVER_DATA_DIR/.$EFFECTIVE_COMMIT.token"
SERVER_ARCH=
SERVER_CONNECTION_TOKEN=
SERVER_DOWNLOAD_URL=

LISTENING_ON=
OS_RELEASE_ID=
ARCH=
PLATFORM=

# System Info (available if detected)
SYSTEM_OS="${SYSTEM_OS}"
SYSTEM_ARCH="${SYSTEM_ARCH}"
SYSTEM_PLATFORM="${SYSTEM_PLATFORM}"
SYSTEM_HOST="${SYSTEM_HOST}"
SYSTEM_USER="${SYSTEM_USER}"

# Mimic output from logs of remote-ssh extension
print_install_results_and_exit() {
    echo "${SCRIPT_ID}: start"
    echo "exitCode==$1=="
    echo "listeningOn==$LISTENING_ON=="
    echo "connectionToken==$SERVER_CONNECTION_TOKEN=="
    echo "logFile==$SERVER_LOGFILE=="
    echo "osReleaseId==$OS_RELEASE_ID=="
    echo "arch==$ARCH=="
    echo "platform==$PLATFORM=="
    echo "tmpDir==$TMP_DIR=="
    echo "${SCRIPT_ID}: end"
    exit 0
}

# Check if platform is supported
KERNEL="$(uname -s)"
case $KERNEL in
    Darwin)
        PLATFORM="darwin"
        ;;
    Linux)
        PLATFORM="linux"
        ;;
    FreeBSD)
        PLATFORM="freebsd"
        ;;
    DragonFly)
        PLATFORM="dragonfly"
        ;;
    AIX)
        PLATFORM="aix"
        ;;
    *)
        echo "Error platform not supported: $KERNEL"
        print_install_results_and_exit 1
        ;;
esac

# Check machine architecture
ARCH="$(uname -m)"
case $ARCH in
    x86_64 | amd64)
        SERVER_ARCH="x64"
        ;;
    armv7l | armv8l)
        SERVER_ARCH="armhf"
        ;;
    arm64 | aarch64)
        SERVER_ARCH="arm64"
        ;;
    ppc64le)
        SERVER_ARCH="ppc64le"
        ;;
    ppc64|powerpc64)
        SERVER_ARCH="ppc64"
        ;;
    riscv64)
        SERVER_ARCH="riscv64"
        ;;
    loongarch64)
        SERVER_ARCH="loong64"
        ;;
    s390x)
        SERVER_ARCH="s390x"
        ;;
    *)
        # Handle AIX special case where uname -m returns machine ID
        if [[ $PLATFORM == "aix" ]]; then
            AIX_ARCH="$(uname -p 2>/dev/null)"
            case $AIX_ARCH in
                powerpc)
                    SERVER_ARCH="ppc64"
                    ARCH="ppc64"
                    ;;
                *)
                    echo "Error AIX architecture not supported: $AIX_ARCH"
                    print_install_results_and_exit 1
                    ;;
            esac
        else
            echo "Error architecture not supported: $ARCH"
            print_install_results_and_exit 1
        fi
        ;;
esac

# Add freeware path for AIX
if [[ $PLATFORM == "aix" ]]; then
    export PATH="/opt/freeware/bin:$PATH"
fi



# Handle OS release detection
if [[ $PLATFORM == "aix" ]]; then
    OS_RELEASE_ID="aix"
else
    OS_RELEASE_ID="$(grep -i '^ID=' /etc/os-release 2>/dev/null | sed 's/^[Ii][Dd]=//' | sed 's/"//g')"
    if [[ -z $OS_RELEASE_ID ]]; then
        OS_RELEASE_ID="$(grep -i '^ID=' /usr/lib/os-release 2>/dev/null | sed 's/^[Ii][Dd]=//' | sed 's/"//g')"
        if [[ -z $OS_RELEASE_ID ]]; then
            OS_RELEASE_ID="unknown"
        fi
    fi
fi

# Create data dir and installation folder (data dir must exist before any log writes)
if [[ ! -d $SERVER_DATA_DIR ]]; then
    mkdir -p $SERVER_DATA_DIR
fi
if [[ ! -d $SERVER_DIR ]]; then
    mkdir -p $SERVER_DIR
    if (( $? > 0 )); then
        echo "Error creating server install directory"
        print_install_results_and_exit 1
    fi
fi

# Separate install-time log (append-only). The server's runtime log ($SERVER_LOGFILE)
# is only written by the background server process itself — install echo output goes here.
INSTALL_LOGFILE="$SERVER_DATA_DIR/install.log"
log() {
    echo "$*" | tee -a "$INSTALL_LOGFILE"
}


# =============================================================================
# resolve_nodejs: find (or download) Node.js and export NODE_EXE + updated PATH
# This runs UNCONDITIONALLY on every launch so the server always has Node in PATH.
# =============================================================================
resolve_nodejs() {
    NODE_EXE=""

    # Probe 1: node already in PATH
    if command -v node >/dev/null 2>&1; then
        NODE_EXE="$(command -v node)"
        log "Node.js probe 1 (PATH): $NODE_EXE"
        return 0
    fi

    # Probe 2: exact path used by cve_scan_mend*.sh
    #   NODE_BIN="$SCRIPT_DIR/../../node-v22.22.3-aix-ppc64/bin/node"
    #   = one level above the project root
    local _sib="$(dirname "$PROJECT_ROOT")/node-v22.22.3-aix-ppc64/bin/node"
    if [[ -x "$_sib" ]]; then
        NODE_EXE="$_sib"
        export PATH="$(dirname "$_sib"):$PATH"
        log "Node.js probe 2 (sibling): $NODE_EXE"
        return 0
    fi
    log "Node.js probe 2 miss: $_sib"

    # Probe 3: common AIX system locations
    for _loc in "/opt/nodejs/bin/node" "/opt/freeware/bin/node" \
                "/usr/bin/node" "/usr/local/bin/node"; do
        if [[ -x "$_loc" ]]; then
            NODE_EXE="$_loc"
            export PATH="$(dirname "$_loc"):$PATH"
            log "Node.js probe 3 (system): $NODE_EXE"
            return 0
        fi
        log "Node.js probe 3 miss: $_loc"
    done

    # Probe 4: glob for any previously extracted tarball under HOME or parent-of-project
    for _root in "$(dirname "$PROJECT_ROOT")" "$HOME"; do
        local _found
        _found=$(find "$_root" -maxdepth 2 -type d -name "node-v*-aix-ppc64" 2>/dev/null | head -1)
        if [[ -n "$_found" && -x "$_found/bin/node" ]]; then
            NODE_EXE="$_found/bin/node"
            export PATH="$_found/bin:$PATH"
            log "Node.js probe 4 (find): $NODE_EXE"
            return 0
        fi
    done
    log "Node.js probe 4 miss: no node-v*-aix-ppc64 dir under $(dirname "$PROJECT_ROOT") or $HOME"

    # Probe 5: download as absolute last resort
    local _ver="v22.22.3"
    local _dir="node-$_ver-aix-ppc64"
    local _dest="$(dirname "$PROJECT_ROOT")"
    log "Node.js probe 5: downloading $_ver to $_dest ..."
    wget --tries=3 --timeout=30 --continue --no-verbose \
        -O "$HOME/$_dir.tar.gz" \
        "https://nodejs.org/dist/$_ver/$_dir.tar.gz" 2>&1 | tee -a "$INSTALL_LOGFILE"
    if [[ $? -eq 0 ]]; then
        tar -xzf "$HOME/$_dir.tar.gz" -C "$_dest/"
        rm -f "$HOME/$_dir.tar.gz"
        NODE_EXE="$_dest/$_dir/bin/node"
        export PATH="$_dest/$_dir/bin:$PATH"
        log "Node.js probe 5 installed: $NODE_EXE"
        return 0
    fi

    log "ERROR: Node.js not found at any known location"
    log "  Tried: PATH, $_sib, /opt/nodejs, /opt/freeware/bin, /usr/bin, /usr/local/bin,"
    log "         find(maxdepth=2) under $(dirname "$PROJECT_ROOT") and $HOME, wget download"
    log "  Install Node.js $($_ver) manually and re-run."
    return 1
}

# adjust platform for vscodium download, if needed
if [[ $OS_RELEASE_ID = alpine ]]; then
    PLATFORM=$OS_RELEASE_ID
fi

# Build server download URL
if [[ $PLATFORM == "aix" ]]; then
    # For AIX, use the VSCodium build version (e.g. 1.105.17075), not the upstream VS Code version (1.105.1)
    DISTRO_FULL_VERSION=${DISTRO_VERSION}+${DISTRO_VSCODIUM_RELEASE}
    SERVER_DOWNLOAD_URL="https://github.com/KV2773/vscodium/releases/download/${DISTRO_FULL_VERSION}/vscodium-server.tar.gz"

    echo "Downloading VSCodium server for AIX from GitHub..."
    echo "URL: $SERVER_DOWNLOAD_URL"
    resolve_nodejs || print_install_results_and_exit 1

    # NODE_EXE is set inside the function — re-export PATH in the *current* shell so
    # the server process inherits it. (export inside a function only affects that scope
    # on AIX bash/ksh.)
    NODE_BIN_DIR="$(dirname "$NODE_EXE")"
    export PATH="$NODE_BIN_DIR:$PATH"
    log "Active Node.js: $NODE_EXE ($("$NODE_EXE" --version 2>&1))"
    log "Exported PATH with Node: $NODE_BIN_DIR"

    # Persist Node.js PATH into .bashrc so future SSH sessions find it automatically
    _BASHRC="$HOME/.bashrc"
    _NODE_MARKER="# === Bob IDE: Node.js PATH ==="
    [ ! -f "$_BASHRC" ] && touch "$_BASHRC"
    if ! grep -Fq "$_NODE_MARKER" "$_BASHRC"; then
        cat >> "$_BASHRC" <<EOF

$_NODE_MARKER
export PATH="$NODE_BIN_DIR:\$PATH"
# === End Bob IDE: Node.js PATH ===
EOF
        log "Added Node.js PATH to $_BASHRC"
    else
        log "Node.js PATH already present in $_BASHRC"
    fi
else
    # Original VSCodium/VSCODE URL for other platforms
    SERVER_DOWNLOAD_URL="$(echo "${SERVER_DOWNLOAD_URL_TEMPLATE}" | sed "s/\\\${quality}/$DISTRO_QUALITY/g" | sed "s/\\\${version}/$DISTRO_VERSION/g" | sed "s/\\\${commit}/$DISTRO_COMMIT/g" | sed "s/\\\${os}/$PLATFORM/g" | sed "s/\\\${arch}/$SERVER_ARCH/g" | sed "s/\\\${release}/$DISTRO_VSCODIUM_RELEASE/g")"
fi

# Check if server script is already installed
if [[ ! -f $SERVER_SCRIPT ]]; then
    case "$PLATFORM" in
        darwin | linux | alpine | aix )
            ;;
        *)
            echo "Error '$PLATFORM' needs manual installation of remote extension host"
            print_install_results_and_exit 1
            ;;
    esac

    pushd $SERVER_DIR > /dev/null || {
        echo "Error: Failed to enter server directory $SERVER_DIR"
        print_install_results_and_exit 1
    }

    # Standard download logic for all platforms including AIX
    if [[ ! -z $(which wget) ]]; then
        wget --tries=3 --timeout=10 --continue --no-verbose -O vscode-server.tar.gz $SERVER_DOWNLOAD_URL
    elif [[ ! -z $(which curl) ]]; then
        curl --retry 3 --connect-timeout 10 --location --show-error --silent --output vscode-server.tar.gz $SERVER_DOWNLOAD_URL
    else
        log "Error no tool to download server binary"
        print_install_results_and_exit 1
    fi

    if (( $? > 0 )); then
        log "Error downloading server from $SERVER_DOWNLOAD_URL"
        print_install_results_and_exit 1
    fi

    log "Extracting server package..."
    if ! tar -xzf vscode-server.tar.gz --strip-components 1; then
        log "Error while extracting server contents"
        print_install_results_and_exit 1
    fi

    if (( $? > 0 )); then
        log "Error while extracting server contents"
        print_install_results_and_exit 1
    fi

    # Special handling for AIX server wrapper
    if [[ $PLATFORM == "aix" ]]; then
        # Ensure the AIX server wrapper is executable
        if [[ -f "$SERVER_DIR/bin/codium-server" ]]; then
            chmod +x "$SERVER_DIR/bin/codium-server"
            log "AIX server wrapper made executable"

            # Create symlink if VS Code expects code-server but we have codium-server
            if [[ "$SERVER_APP_NAME" == "bobide-server" && ! -f "$SERVER_DIR/bin/bobide-server" ]]; then
                ln -sf "$SERVER_DIR/bin/codium-server" "$SERVER_DIR/bin/bobide-server"
                log "Created symlink: bobide-server -> codium-server"
            fi
        fi

        # Get Node.js directory
        NODE_DIR="$(dirname "$NODE_EXE")"
        NODE_PRE_DIR="$(dirname "$NODE_DIR")"

        log "=== Patching Server Files ==="
        log "DEBUG: NODE_EXE=$NODE_EXE"
        log "DEBUG: NODE_DIR=$NODE_DIR"
        log "DEBUG: NODE_PRE_DIR=$NODE_PRE_DIR"
        log "Replacing: /opt/nodejs  With: $NODE_PRE_DIR"

        # Count files to patch
        FILE_COUNT=$(find "$SERVER_DIR" -type f \( -name "*.sh" -o -name "*.js" -o -name "*.json" -o -name "*-server" \) -exec grep -l "/opt/nodejs" {} \; 2>/dev/null | wc -l)
        log "Found $FILE_COUNT files to patch"

        if [[ $FILE_COUNT -gt 0 ]]; then
            find "$SERVER_DIR" -type f \( -name "*.sh" -o -name "*.js" -o -name "*.json" -o -name "*-server" \) -exec grep -l "/opt/nodejs" {} \; 2>/dev/null | while read -r file; do
                log "  Patching: ${file#$SERVER_DIR/}"
                sed -i.bak "s|/opt/nodejs|${NODE_PRE_DIR}|g" "$file"
                rm -f "${file}.bak"
            done
            log "✓ Patched $FILE_COUNT files"
        else
            log "No files need patching"
        fi

        # Patch product.json to match Bob IDE commit/version for client handshake
        if [[ -f "$SERVER_DIR/product.json" ]]; then
            log "=== AIX VSCodium Server Version Update ==="
            log "Patching product.json: version=$DISTRO_VERSION  commit=$DISTRO_COMMIT"

            # Backup original product.json
            cp "$SERVER_DIR/product.json" "$SERVER_DIR/product.json.backup"

            # Update version and commit in product.json using perl for in-place editing
            # This ensures the AIX server (VSCodium build) reports the correct Bob IDE version
            perl -i -pe "s/\"version\":\s*\"[^\"]*\"/\"version\": \"$DISTRO_VERSION\"/" "$SERVER_DIR/product.json"
            perl -i -pe "s/\"commit\":\s*\"[^\"]*\"/\"commit\": \"$DISTRO_COMMIT\"/" "$SERVER_DIR/product.json"

            log "✓ product.json patched successfully"
            grep -E "(commit|version)" "$SERVER_DIR/product.json" | head -5 | tee -a "$INSTALL_LOGFILE"
            log "Backup saved: product.json.backup"
        else
            log "Warning: product.json not found at $SERVER_DIR/product.json"
        fi

        # Update package.json if it exists
        if [[ -f "$SERVER_DIR/package.json" ]]; then
            log "Updating package.json version..."
            cp "$SERVER_DIR/package.json" "$SERVER_DIR/package.json.backup"
            perl -i -pe "s/\"version\":\s*\"[^\"]*\"/\"version\": \"$DISTRO_VERSION\"/" "$SERVER_DIR/package.json"
            log "✓ package.json updated"
        fi

        # Create version marker files for reference
        echo "$DISTRO_VERSION" > "$SERVER_DIR/version"
        echo "$DISTRO_COMMIT" > "$SERVER_DIR/commit"
        log "✓ Created version marker files"

        log "=== AIX Server Setup Complete ==="

        BASHRC="$HOME/.bashrc"
        SNIPPET_MARKER="# === VSCodium remote-cli PATH setup ==="

        # Create .bashrc if it doesn't exist
        if [ ! -f "$BASHRC" ]; then
            touch "$BASHRC"
        fi

        # Add snippet only if it's not already present
        if ! grep -Fq "$SNIPPET_MARKER" "$BASHRC"; then
            cat >> "$BASHRC" <<'EOF'

# === VSCodium remote-cli PATH setup ===
# Add all matching remote-cli directories to PATH
if [ -d "$HOME/.vscodium-server/bin" ]; then
  for dir in "$HOME"/.vscodium-server/bin/*/bin/remote-cli; do
      if [ -d "$dir" ]; then
          PATH="$PATH:$dir"
      fi
  done
  export PATH
fi
# === End VSCodium remote-cli PATH setup ===

EOF
            log "remote-cli PATH snippet added to $BASHRC"
        else
            log "Snippet already present in $BASHRC, not adding again."
        fi
    fi

    if [[ ! -f $SERVER_SCRIPT ]]; then
        log "Error server contents are corrupted"
        log "Expected script at: $SERVER_SCRIPT"
        log "Directory contents:"
        ls -la "$SERVER_DIR/bin/" 2>&1 | tee -a "$INSTALL_LOGFILE" || true
        print_install_results_and_exit 1
    fi

    log "Server script found: $SERVER_SCRIPT"
    log "Server script is executable: $(test -x $SERVER_SCRIPT && echo yes || echo no)"

    rm -f vscode-server.tar.gz

    popd > /dev/null
else
    log "Server script already installed in $SERVER_SCRIPT"
fi

# Try to find if server is already running
if [[ -f $SERVER_PIDFILE ]]; then
    SERVER_PID="$(cat $SERVER_PIDFILE)"
    SERVER_RUNNING_PROCESS="$(ps -o pid,args -p $SERVER_PID | grep $SERVER_SCRIPT)"
else
    SERVER_RUNNING_PROCESS="$(ps -o pid,args -A | grep $SERVER_SCRIPT | grep -v grep)"
fi

if [[ -z $SERVER_RUNNING_PROCESS ]]; then
    if [[ -f $SERVER_LOGFILE ]]; then
        rm $SERVER_LOGFILE
    fi
    if [[ -f $SERVER_TOKENFILE ]]; then
        rm $SERVER_TOKENFILE
    fi

    touch $SERVER_TOKENFILE
    chmod 600 $SERVER_TOKENFILE
    # Generate a UUID portably: uuidgen (macOS/Linux), /proc fallback (Linux), od fallback (AIX)
    SERVER_CONNECTION_TOKEN="${crypto.randomUUID()}"
    echo $SERVER_CONNECTION_TOKEN > $SERVER_TOKENFILE

    $SERVER_SCRIPT --start-server --host=127.0.0.1 $SERVER_LISTEN_FLAG $SERVER_INITIAL_EXTENSIONS --connection-token-file $SERVER_TOKENFILE --telemetry-level off --enable-remote-auto-shutdown --accept-server-license-terms >> $SERVER_LOGFILE 2>&1 &
    echo $! > $SERVER_PIDFILE
else
    log "Server script is already running $SERVER_SCRIPT"
fi

if [[ -f $SERVER_TOKENFILE ]]; then
    SERVER_CONNECTION_TOKEN="$(cat $SERVER_TOKENFILE)"
else
    echo "Error server token file not found $SERVER_TOKENFILE"
    print_install_results_and_exit 1
fi

if [[ -f $SERVER_LOGFILE ]]; then
    for i in {1..5}; do
        LISTENING_ON="$(cat $SERVER_LOGFILE | grep -E 'Extension host agent listening on .+' | sed 's/Extension host agent listening on //')"
        if [[ -n $LISTENING_ON ]]; then
            break
        fi
        sleep 1
    done

    if [[ -z $LISTENING_ON ]]; then
        echo "Error server did not start successfully"
        print_install_results_and_exit 1
    fi
else
    echo "Error server log file not found $SERVER_LOGFILE"
    print_install_results_and_exit 1
fi

# Finish server setup
print_install_results_and_exit 0

